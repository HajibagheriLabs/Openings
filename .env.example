# Copy to .env.local and fill in. Every name here is validated in src/env.ts.
# Values marked OPTIONAL may be left blank — the comment says what degrades.

# --- Database ---------------------------------------------------------------
# Postgres. Neon in deployment; any Postgres 14+ locally.
# The btree_gist extension is required — the no-overlap exclusion constraint
# depends on it.
DATABASE_URL="postgresql://user:password@localhost:5432/openings"

# --- Auth (business owners only; customers book as guests) -------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Public origin ----------------------------------------------------------
# Used for links in email and for Stripe success/cancel redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Payments (Stripe, test mode) -------------------------------------------
# OPTIONAL. Without these, deposits are disabled and booking completes free.
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Email (Resend) ---------------------------------------------------------
# OPTIONAL. Without a key the mailer prints the message to the console instead
# of sending, so the whole booking flow still works offline.
RESEND_API_KEY=""
EMAIL_FROM="Openings <onboarding@resend.dev>"

# --- Scheduled work (Upstash QStash) ----------------------------------------
# OPTIONAL. Without these, per-booking reminders are not scheduled and the
# daily cron is the only safety net.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# --- Daily cron -------------------------------------------------------------
# OPTIONAL locally. Shared secret the Vercel cron presents to the janitor route.
CRON_SECRET=""

# --- Demo seed --------------------------------------------------------------
# OPTIONAL. Credentials the seed script gives the demo business owner.
DEMO_OWNER_EMAIL="owner@example.com"
DEMO_OWNER_PASSWORD=""
