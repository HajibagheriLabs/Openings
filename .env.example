# Copy to .env.local and fill in. Every name here is validated in src/env.ts.
# Values marked OPTIONAL may be left blank — the comment says what degrades.

# --- Database ---------------------------------------------------------------
# Postgres. Neon in deployment; any Postgres 14+ locally.
# The btree_gist extension is required — the no-overlap exclusion constraint
# depends on it.
DATABASE_URL="postgresql://user:password@localhost:5432/openings"

# Separate database for the test suite. The concurrency tests TRUNCATE tables,
# so they refuse to run against DATABASE_URL. A Neon branch is the easy option.
TEST_DATABASE_URL=""

# --- Auth (business owners only; customers book as guests) -------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Public origin ----------------------------------------------------------
# Used for links in email and for Stripe success/cancel redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Payments (Stripe, TEST MODE ONLY) --------------------------------------
# OPTIONAL. Without STRIPE_SECRET_KEY the card step cannot run: a service with
# a deposit keeps its hold and tells the customer to arrange payment with the
# business directly, and a service with no deposit books as normal. Nothing is
# silently charged and nothing is silently free.
#
# The app REFUSES a live key. Test keys only — see src/lib/payments/stripe.ts.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# The signing secret for the webhook route. NOT something to invent: it is
# issued by Stripe, and a value that does not match makes every event fail
# signature verification.
#   locally  →  stripe listen --print-secret
#               (the same secret `stripe listen --forward-to ...` prints)
#   deployed →  Stripe Dashboard → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=""

# NOTE ON A SHARED TEST ACCOUNT. A Stripe test-mode account belongs to a
# developer, not to a project, so it may well be serving another app too — and
# `stripe listen` forwards EVERY event on the account to whatever endpoint it
# is pointed at. Every object this app creates carries metadata.app=openings so
# the webhook can ignore the rest. Narrow the firehose as well:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe \
#     --events checkout.session.completed,checkout.session.expired,charge.refunded
# Run only ONE `stripe listen` at a time, or events arrive twice.

# --- Email (Resend) ---------------------------------------------------------
# OPTIONAL. Without a key the mailer prints the message to the console instead
# of sending, so the whole booking flow still works offline.
RESEND_API_KEY=""
EMAIL_FROM="Openings <onboarding@resend.dev>"

# --- Reminder scheduling (Upstash QStash) -----------------------------------
# OPTIONAL, AND THE PRODUCT WORKS WITHOUT IT.
#
# WHY IT EXISTS: a Vercel Hobby project may run at most ONE cron per day, and
# not at a guaranteed minute. That cannot deliver "24 hours before the
# appointment", so each reminder gets its own scheduled delivery instead — a
# QStash message with a future `notBefore`, pointing at
# POST /api/notifications/deliver and carrying the notification id.
#
# The token publishes and cancels messages. The two signing keys verify that an
# incoming delivery really came from QStash; without them the delivery route
# rejects everything, because an unauthenticated caller could otherwise ask it
# to send email.
#
# WITHOUT THESE: nothing is scheduled, anything already due is sent inline the
# moment a booking is confirmed, and reminders wait for the daily sweep — up to
# a day late, never lost. The admin settings page says which mode is running.
#
# NOTE: QStash delivers by calling a URL it can reach. With
# NEXT_PUBLIC_APP_URL on localhost, scheduling is skipped on purpose rather
# than publishing messages into a dead letter queue. Point it at a tunnel to
# exercise the real path locally.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# --- Daily safety net -------------------------------------------------------
# The shared secret for the daily sweep at /api/cron/daily, which delivers
# anything the scheduler did not, reclaims expired holds, and forgets old
# Stripe event ids. Presented as `Authorization: Bearer <secret>` — exactly
# what a Vercel cron sends, so nothing has to be configured twice.
#
# OPTIONAL LOCALLY, REQUIRED IN PRODUCTION. Without it the route refuses to run
# when NODE_ENV=production, because an open sweep is an open "send every queued
# email now" button. In development it runs and warns, so the whole product
# still works on a laptop with nothing but a database.
#
# CORRECTNESS DOES NOT DEPEND ON THIS JOB. It is a net, not the mechanism.
CRON_SECRET=""

# --- Demo workspace ---------------------------------------------------------
# OPTIONAL, and only needed if you want the demo.
#
# `npm run db:seed` builds two sample businesses in two different timezones —
# a salon in Europe/Lisbon and a clinic in America/Chicago — with staff, real
# weekly hours, time off, and a fortnight of appointments either side of today.
# It is idempotent: run it again and you get the same demo, re-anchored to the
# new today. Both businesses are marked `is_demo`, which turns on a banner in
# the owner area and a database trigger that stops a visitor deleting the
# scenery (migration 0013).
#
# The address below is the salon owner's sign-in. The clinic's owner is the
# same address with `+clinic` before the @, so one real inbox covers both.
#
# /demo signs a visitor in as the salon owner with these credentials and lands
# them on today's agenda. Leave them blank and /demo says the demo is not set
# up rather than failing.
#
# At least 10 characters — the same rule the sign-up form enforces, so the
# seeded account can actually sign in. Change it and re-run the seed.
DEMO_OWNER_EMAIL="owner@example.com"
DEMO_OWNER_PASSWORD=""
