# Copy to .env.local and fill in. Every name here is validated in src/env.ts.
# Values marked OPTIONAL may be left blank — the comment says what degrades.

# --- Database ---------------------------------------------------------------
# Postgres. Neon in deployment; any Postgres 14+ locally.
# The btree_gist extension is required — the no-overlap exclusion constraint
# depends on it.
DATABASE_URL="postgresql://user:password@localhost:5432/openings"

# Separate database for the test suite. The concurrency tests TRUNCATE tables,
# so they refuse to run against DATABASE_URL. A Neon branch is the easy option.
TEST_DATABASE_URL=""

# --- Auth (business owners only; customers book as guests) -------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Public origin ----------------------------------------------------------
# Used for links in email and for Stripe success/cancel redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Payments (Stripe, TEST MODE ONLY) --------------------------------------
# OPTIONAL. Without STRIPE_SECRET_KEY the card step cannot run: a service with
# a deposit keeps its hold and tells the customer to arrange payment with the
# business directly, and a service with no deposit books as normal. Nothing is
# silently charged and nothing is silently free.
#
# The app REFUSES a live key. Test keys only — see src/lib/payments/stripe.ts.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# The signing secret for the webhook route. NOT something to invent: it is
# issued by Stripe, and a value that does not match makes every event fail
# signature verification.
#   locally  →  stripe listen --print-secret
#               (the same secret `stripe listen --forward-to ...` prints)
#   deployed →  Stripe Dashboard → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=""

# NOTE ON A SHARED TEST ACCOUNT. A Stripe test-mode account belongs to a
# developer, not to a project, so it may well be serving another app too — and
# `stripe listen` forwards EVERY event on the account to whatever endpoint it
# is pointed at. Every object this app creates carries metadata.app=openings so
# the webhook can ignore the rest. Narrow the firehose as well:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe \
#     --events checkout.session.completed,checkout.session.expired,charge.refunded
# Run only ONE `stripe listen` at a time, or events arrive twice.

# --- Email (Resend) ---------------------------------------------------------
# OPTIONAL. Without a key the mailer prints the message to the console instead
# of sending, so the whole booking flow still works offline.
RESEND_API_KEY=""
EMAIL_FROM="Openings <onboarding@resend.dev>"

# --- Scheduled work (Upstash QStash) ----------------------------------------
# OPTIONAL. Without these, per-booking reminders are not scheduled and the
# daily cron is the only safety net.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# --- Daily cron -------------------------------------------------------------
# OPTIONAL locally. Shared secret the Vercel cron presents to the janitor route.
CRON_SECRET=""

# --- Demo seed --------------------------------------------------------------
# OPTIONAL. Credentials the seed script gives the demo business owner.
DEMO_OWNER_EMAIL="owner@example.com"
DEMO_OWNER_PASSWORD=""
